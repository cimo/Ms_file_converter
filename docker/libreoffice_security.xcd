                </prop>
                <prop oor:name="ODFRecalcMode" oor:finalized="true">
                    <value>1</value>
                </prop>
            </node>
        </node>
    </oor:component-data>
    <oor:component-data oor:name="Writer" oor:package="org.openoffice.Office">
        <node oor:name="Content">
